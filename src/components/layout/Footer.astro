---
/**
 * Site footer. Editorial colophon — small italic serif, hairline rule,
 * monospace date stamp.
 */
import { SITE, SOCIAL } from '../../lib/site.ts';

const year = new Date().getFullYear();
---

<footer class="mt-32">
  <hr class="rule" />

  <div class="mx-auto w-full max-w-3xl px-6 py-12 sm:px-8 lg:max-w-4xl">
    <p class="kicker">Colophon</p>

    <p class="mt-4 body-text text-fg-muted">
      Built with <a class="text-accent underline-offset-4 hover:underline" href="https://astro.build">Astro</a> &amp;
      <a class="text-accent underline-offset-4 hover:underline" href="https://tailwindcss.com">Tailwind</a>.
      Self-hosted typography: <span class="font-serif italic">Fraunces</span> &amp; Geist.
      Static-first, no third-party scripts, no trackers.
    </p>

    <p class="mt-3 body-text text-fg-muted">
      Content reflects the source material in the
      <a class="text-accent underline-offset-4 hover:underline" href={SITE.cvPath}>résumé</a>.
    </p>

    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-fg-subtle" role="list">
      {SOCIAL.map((link) => (
        <li>
          <a
            href={link.href}
            class="hover:text-accent"
            rel="noopener noreferrer"
            target={link.href.startsWith('http') ? '_blank' : undefined}
          >
            {link.label.toLowerCase()}
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-12 font-mono text-xs text-fg-faint">
      © {year} {SITE.name}. Set in Fraunces &amp; Geist.
    </p>
  </div>
</footer>