---
import Legal from '../layouts/Legal.astro';
const sections = [
  { id: 'choice', title: 'What is required, and what is optional', text: 'A full name is required on both continuation paths. To preview the full introduction, add an email and check the agreement box; a comment is optional. You can instead continue with your name only, without email or agreement. The checkbox starts unchecked. These policy pages can be read without completing the form.' },
  { id: 'details', title: 'What happens to your details', text: 'In this design preview, the text you enter stays in the form in your browser. The preview button checks the fields locally. This site does not send those values to Abdul, store them in a database, or save them in cookies or browser storage. Your browser’s own autofill and page-restoration features may remember fields according to your browser settings.' },
  { id: 'tracking', title: 'No visitor tracking in this preview', text: 'This preview does not include analytics, advertising trackers, visitor notifications, or tracking cookies. Fonts are served with the site, without contacting a font service. The local development server receives page and asset requests to display the preview.' },
  { id: 'email', title: 'If you email me directly', text: 'Using the email link opens your email application. Sending an email is a separate choice: your message and address are then handled by your email provider and the recipient’s email provider. Please do not include sensitive or confidential information.' },
  { id: 'external', title: 'Staying in this preview', text: 'Continuing with your name only keeps you here and shows where this preview ends. It does not send your name or any other form details, and does not open another website. The terms and privacy links in the form open in a new tab so you can read them without losing your place.' },
  { id: 'future', title: 'Before messages go live', text: 'Before this form collects introductions or any visitor notifications are added, this policy will explain the actual purpose, providers, storage, retention, and how to request deletion. Collection will not be enabled simply because this preview exists.' },
];
---
<Legal title="Privacy, with clarity." summary="A clear account of what you enter, what stays here, and what comes next." page="privacy" sections={sections} />
