---
/**
 * Section — restrained editorial section wrapper.
 *
 * No eyebrow chips, no card frames. Just an optional small kicker
 * + serif heading, then the slot. Generous spacing.
 */

export interface Props {
  id?: string;
  title?: string;
  /** Small italic serif line above the title — used as a kicker. */
  kicker?: string;
}

const { id, title, kicker } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section
  id={id}
  aria-labelledby={title && id ? headingId : undefined}
  class="scroll-mt-24 py-16 sm:py-20"
>
  {(kicker || title) && (
    <header class="mb-10">
      {kicker && (
        <p class="font-serif text-base italic text-fg-subtle">{kicker}</p>
      )}
      {title && (
        <h2
          id={headingId}
          class="display mt-2 text-3xl sm:text-4xl"
        >
          {title}
        </h2>
      )}
    </header>
  )}
  <slot />
</section>