---
/**
 * Tag — small inline marker used for tech stacks, skill chips.
 * Editorial: sans-serif, small, subtle, never a button-style pill.
 */

export interface Props {
  label: string;
  href?: string;
}

const { label, href } = Astro.props;
---

{href ? (
  <a
    href={href}
    class="font-mono text-xs text-fg-muted underline-offset-4 hover:text-accent hover:underline"
  >
    {label}
  </a>
) : (
  <span class="font-mono text-xs text-fg-muted">{label}</span>
)}

<style>
  /* small separator when used in a row */
  :global(.tag-row > *) + :global(.tag-row > *)::before {
    content: "·";
    margin: 0 0.5rem;
    color: var(--color-fg-faint);
  }
</style>