---
/**
 * Experience — chronological list of roles.
 *
 * Editorial layout:
 *   - Italic serif kicker above each entry: role at company
 *   - Small mono date stamp on the right (marginalia-style on desktop)
 *   - Body paragraphs with generous rhythm
 *   - Tech stack as a flowing list, not boxed chips
 */
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';

const entries = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);

const formatPeriod = (start: string, end?: string): string => {
  const endLabel = end ?? 'present';
  return `${start} → ${endLabel}`;
};
---

<Section id="experience" kicker="A working history" title="Experience">
  <ol class="space-y-16" role="list">
    {entries.map((entry) => (
      <li class="grid grid-cols-1 gap-6 sm:grid-cols-[1fr_8rem] sm:gap-10">
        <div>
          <p class="font-serif text-lg italic text-fg">
            {entry.data.role}
            <span class="text-fg-subtle"> · </span>
            <span class="text-fg">{entry.data.company}</span>
          </p>

          <p class="mt-3 body-text text-fg">{entry.data.summary}</p>

          {entry.data.highlights.length > 0 && (
            <ul class="mt-5 body-text text-fg-muted" role="list">
              {entry.data.highlights.map((h) => (
                <li class="relative pl-5">
                  <span aria-hidden="true" class="absolute left-0 top-0 text-accent">·</span>
                  {h}
                </li>
              ))}
            </ul>
          )}

          {entry.data.stack.length > 0 && (
            <p class="caption mt-5">
              <span class="font-mono uppercase tracking-wider text-fg-subtle">Stack — </span>
              <span>{entry.data.stack.join(' · ')}</span>
            </p>
          )}
        </div>

        <aside class="font-mono text-xs text-fg-subtle sm:text-right">
          <p class="text-fg">{formatPeriod(entry.data.startDate, entry.data.endDate)}</p>
          <p class="mt-1 text-fg-muted">{entry.data.location}</p>
        </aside>
      </li>
    ))}
  </ol>
</Section>