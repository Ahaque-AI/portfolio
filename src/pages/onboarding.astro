---
import Shell from '../layouts/Shell.astro';
import Arrow from '../components/Arrow.astro';
import StarMap from '../components/StarMap.astro';
import GuidedFlight from '../components/GuidedFlight.astro';
---
<Shell title="The route ahead" description="A guided map of Abdul Haque's portfolio sections." page="onboarding">
  <main id="main" class="onboarding-layout">
    <section class="onboarding-copy" aria-labelledby="onboarding-title">
      <a class="back-link" href="/?edit=1"><Arrow back /> Back to introduction</a>
      <h1 id="onboarding-title">Follow the<br /><span>signal.</span></h1>
      <p class="onboarding-lede">Meet the person behind the work. Open About on the map, or take the spaceship for a guided introduction.</p>
      <button class="tutorial-trigger orbit-action" id="tutorial-trigger" type="button"><span>Launch guided flight</span><Arrow /></button>
      <p class="route-note"><span class="location-dot"></span> Arrival and About are open. Work is joining soon.</p>
    </section>
    <section class="onboarding-map" aria-labelledby="map-title">
      <h2 id="map-title" class="sr-only">Portfolio section map</h2>
      <StarMap />
      <div class="map-legend"><span><i class="legend-dot legend-active"></i> 2 destinations open</span><span><i class="legend-dot legend-future"></i> Work joining soon</span></div>
    </section>
  </main>
  <GuidedFlight />
  <button class="free-roam" id="free-roam" type="button">Explore freely</button>
  <p class="guided-first-note" id="guided-first-note" role="status" hidden>First signal received. Launch the guided flight to begin.</p>
</Shell>
