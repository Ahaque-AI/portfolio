---
/**
 * Skills — categorized technical skills, rendered from the SKILLS constant
 * in src/lib/site.ts. Static list lives with site data; a future pass can
 * promote it to a content collection if skills need per-item editing.
 */
import { SKILLS } from '../../lib/site.ts';
import Section from '../ui/Section.astro';
---

<Section id="skills" eyebrow="Skills" title="What I work with">
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {SKILLS.map((group) => (
      <div class="rounded-lg border border-border bg-surface p-5">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-fg-muted">
          {group.category}
        </h3>
        <ul class="mt-3 flex flex-wrap gap-2" role="list">
          {group.items.map((item) => (
            <li class="rounded border border-border bg-bg px-2 py-0.5 text-xs text-fg">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
