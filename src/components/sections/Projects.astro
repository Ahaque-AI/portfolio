---
/**
 * Projects — research + side work, rendered from the `projects` content
 * collection. Source of truth: src/content/projects/*.md.
 *
 * Sorted by `order` ascending. Featured projects render first.
 */
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import Tag from '../ui/Tag.astro';

const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="projects" eyebrow="Projects & Research" title="Selected work">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {entries.map((project) => (
      <article class="flex h-full flex-col rounded-lg border border-border bg-surface p-6 transition-colors hover:border-fg-muted">
        <header class="flex items-baseline justify-between gap-2">
          <h3 class="text-lg font-semibold text-fg">{project.data.title}</h3>
          <span class="font-mono text-xs text-fg-subtle">{project.data.period}</span>
        </header>

        <p class="mt-3 text-sm text-fg-muted">{project.data.summary}</p>

        <ul class="mt-4 flex flex-wrap gap-2" role="list">
          {project.data.stack.map((tech) => <Tag label={tech} />)}
        </ul>

        {project.data.links.length > 0 && (
          <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-6 text-sm" role="list">
            {project.data.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-fg underline-offset-4 hover:underline"
                >
                  {link.label} ↗
                </a>
              </li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </div>
</Section>
