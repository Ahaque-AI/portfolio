---
/**
 * Site navigation. Editorial aesthetic — text-only nav, serif mark,
 * no SaaS-style buttons or status pills.
 */
import { NAV, SITE } from '../../lib/site.ts';
---

<header class="border-b border-border">
  <nav
    class="mx-auto flex w-full max-w-3xl items-baseline justify-between gap-6 px-6 py-6 sm:px-8 lg:max-w-4xl"
    aria-label="Primary"
  >
    <a
      href="/"
      class="display text-xl font-medium tracking-tight text-fg hover:text-accent transition-colors"
    >
      {SITE.name}
    </a>

    <!-- Desktop nav -->
    <ul class="hidden gap-7 sm:flex" role="list">
      {NAV.map((item) => (
        <li>
          <a
            href={item.href}
            class="font-serif text-base text-fg-muted italic hover:text-accent transition-colors"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile disclosure -->
    <details class="sm:hidden relative">
      <summary
        class="cursor-pointer list-none font-serif italic text-base text-fg-muted"
        aria-label="Toggle navigation"
      >
        Menu
      </summary>
      <ul
        class="absolute right-0 top-full z-10 mt-2 min-w-44 border border-border bg-bg-elevated p-3 shadow-md"
        role="list"
      >
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="block px-2 py-1.5 font-serif italic text-base text-fg-muted hover:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>