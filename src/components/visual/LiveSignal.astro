---
/**
 * LiveSignal — large full-width schematic of the therapy microservice
 * pipeline Abdul shipped at DeltaShoppe.
 *
 * Editorial redesign: stages are big enough to read at a glance, the
 * whole thing breathes, annotation sits beneath as a caption. No SaaS
 * decoration; the schematic IS the work.
 *
 * Five stages, horizontal on desktop, stacked on mobile. Light pulses
 * travel along the wires (CSS keyframes, killed by prefers-reduced-motion).
 */

interface Stage {
  readonly id: string;
  readonly title: string;
  readonly subtitle: string;
  readonly kind: 'input' | 'process' | 'queue' | 'process' | 'store';
}

const STAGES: readonly Stage[] = [
  { id: '01', title: 'Audio in',  subtitle: 'session · opus',     kind: 'input'   },
  { id: '02', title: 'Faster-Whisper', subtitle: 'STT · INT8 · CPU',  kind: 'process' },
  { id: '03', title: 'Azure Service Bus', subtitle: 'event queue · async', kind: 'queue' },
  { id: '04', title: 'Phi-3.5-Mini',     subtitle: 'summary · 15 GB pod',  kind: 'process' },
  { id: '05', title: 'Session record',   subtitle: 'Postgres · pgvector',  kind: 'store'   },
];

const PATHS = [
  'M 175 70 L 305 70',
  'M 435 70 L 565 70',
  'M 695 70 L 825 70',
  'M 955 70 L 1085 70',
];

const W = 1180;
const H = 160;
---

<figure class="my-12">
  <!-- Desktop -->
  <svg
    class="hidden w-full sm:block"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="Schematic of the AI therapy microservice pipeline"
  >
    <!-- Connectors -->
    <g stroke="currentColor" stroke-width="1" class="text-border" fill="none">
      {PATHS.map((d) => <path d={d} stroke-dasharray="4 4" />)}
    </g>

    <!-- Pulses -->
    <g fill="currentColor" class="text-accent">
      {PATHS.map((d, i) => (
        <circle r="3">
          <animateMotion
            dur={`${2.6 + i * 0.4}s`}
            repeatCount="indefinite"
            path={d}
            begin={`${i * 0.5}s`}
          />
        </circle>
      ))}
    </g>

    <!-- Stages -->
    <g>
      {STAGES.map((s, i) => {
        const x = i * 130 + 35;
        const isQueue = s.kind === 'queue';
        return (
          <g transform={`translate(${x} 30)`}>
            <rect
              x="0"
              y="0"
              width="130"
              height="80"
              rx="1"
              fill="oklch(1 0 0)"
              stroke="currentColor"
              stroke-width="1"
              stroke-dasharray={isQueue ? '5 4' : '0'}
              class="text-border"
            />
            <text
              x="10"
              y="18"
              fill="currentColor"
              class="text-fg-subtle"
              font-family="Geist Mono, monospace"
              font-size="10"
              letter-spacing="1.5"
            >
              {s.id}
            </text>
            <text
              x="10"
              y="40"
              fill="currentColor"
              class="text-fg"
              font-family="Fraunces, serif"
              font-size="15"
              font-weight="500"
            >
              {s.title}
            </text>
            <text
              x="10"
              y="60"
              fill="currentColor"
              class="text-accent"
              font-family="Geist Mono, monospace"
              font-size="10"
            >
              {s.subtitle}
            </text>
          </g>
        );
      })}
    </g>
  </svg>

  <!-- Mobile (stacked) -->
  <ol class="flex flex-col gap-3 sm:hidden" role="list">
    {STAGES.map((s) => (
      <li class="border border-border bg-bg-elevated px-4 py-3">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-fg-subtle">{s.id}</p>
        <p class="mt-1 font-serif text-lg text-fg">{s.title}</p>
        <p class="font-mono text-xs text-accent">{s.subtitle}</p>
      </li>
    ))}
  </ol>

  <figcaption class="caption mt-6">
    <span class="font-serif italic text-fg">The therapy microservice, drawn as it actually runs.</span>
    Event-driven audio pipeline on Azure Service Bus, decoupling transcription and summarisation
    into background jobs. CPU-only 15&nbsp;GB AKS pods, MLflow observability, JWKS-verified sessions,
    encrypted audio at rest.
    <span class="font-mono text-fg-subtle">300+ sessions/day · INT8 · 5× concurrency · healthcare client</span>
  </figcaption>
</figure>