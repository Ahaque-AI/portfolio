---
/**
 * Contact — short closing block that surfaces direct contact channels.
 * Source of truth: PROFILE + SOCIAL in src/lib/site.ts.
 */
import { PROFILE, SOCIAL } from '../../lib/site.ts';
import Section from '../ui/Section.astro';
---

<Section id="contact" eyebrow="Contact" title="Get in touch">
  <p class="max-w-2xl text-fg-muted">
    Open to backend, platform, and applied-AI roles where production reliability
    and engineering rigor matter. Reach out directly — I read everything.
  </p>

  <dl class="mt-8 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
    <div>
      <dt class="text-xs uppercase tracking-wider text-fg-subtle">Email</dt>
      <dd class="mt-1">
        <a class="hover:underline" href={`mailto:${PROFILE.email}`}>
          {PROFILE.email}
        </a>
      </dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wider text-fg-subtle">Phone</dt>
      <dd class="mt-1 text-fg">{PROFILE.phone}</dd>
    </div>
    {SOCIAL.map((link) => (
      <div>
        <dt class="text-xs uppercase tracking-wider text-fg-subtle">{link.label}</dt>
        <dd class="mt-1">
          <a
            class="hover:underline"
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
          >
            {link.handle ?? link.href}
          </a>
        </dd>
      </div>
    ))}
  </dl>
</Section>
