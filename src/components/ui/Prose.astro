---
/**
 * Prose — long-form markdown styling for case studies.
 * Editorial: serif body via Fraunces, generous rhythm, drop cap optional,
 * pull quotes for emphasis, footnoted superscripts.
 */
---

<div
  class="
    prose-scope body-text
    [&_a]:text-accent [&_a]:underline-offset-4 [&_a:hover]:underline
    [&_h2]:display [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:sm:text-3xl
    [&_h3]:display [&_h3]:mt-10 [&_h3]:text-xl [&_h3]:sm:text-2xl
    [&_p]:mt-6 [&_p:first-child]:mt-0
    [&_strong]:font-medium [&_strong]:text-fg
    [&_em]:italic
    [&_code]:font-mono [&_code]:text-[0.92em] [&_code]:text-accent [&_code]:before:content-['`'] [&_code]:after:content-['`']
    [&_ul]:mt-6 [&_ol]:mt-6 [&_li]:mt-3
    [&_blockquote]:pull-quote
    [&_hr]:rule [&_hr]:my-12
    drop-cap
  "
>
  <slot />
</div>