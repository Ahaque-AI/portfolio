---
import Shell from '../layouts/Shell.astro';
import Orbit from '../components/Orbit.astro';
import Arrow from '../components/Arrow.astro';
---
<Shell title="A small hello" description="A space for a small hello. Meet Abdul Haque, AI software engineer, and leave an optional introduction.">
  <main id="main" class="intro-layout">
    <section class="arrival" aria-labelledby="arrival-title">
      <h1 id="arrival-title">A small hello.<br /><span>A new orbit.</span></h1>
      <p class="arrival-copy">I’m Abdul. I build AI systems.<br />But everything starts with a human connection.</p>
      <Orbit />
      <div class="orbit-caption"><span class="caption-line"></span><p>Different paths.<br /><span>An interesting place to cross.</span></p></div>
    </section>
    <section class="introduction" aria-labelledby="form-title">
      <div class="form-heading"><h2 id="form-title">Before you explore.</h2><p>Start with your full name.<br />Add your email and a note, or continue with just your name.</p></div>
      <form id="introduction-form" novalidate aria-describedby="preview-note">
        <fieldset id="form-fields" disabled>
          <div class="field"><label for="full-name">Full name</label><input id="full-name" name="fullName" autocomplete="name" placeholder="What should I call you?" maxlength="120" required aria-describedby="name-error" /><span class="field-error" id="name-error"></span></div>
          <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="254" required aria-describedby="email-error" /><span class="field-error" id="email-error"></span></div>
          <div class="field comment-field"><label for="comment">A note for me <span>Optional</span></label><textarea id="comment" name="comment" rows="3" maxlength="1000" placeholder="An idea, a question, or just a hello…" style="resize: none" aria-describedby="comment-help comment-error"></textarea><div class="comment-meta"><span id="comment-help">A little context goes a long way.</span><span id="comment-count">0 / 1,000</span></div><span class="field-error" id="comment-error"></span></div>
          <div class="consent"><div class="consent-line"><input type="checkbox" id="agreement" name="agreement" required aria-describedby="agreement-error" /><label for="agreement">I agree to the <a href="/terms/" target="_blank" rel="noopener">terms & conditions<span class="sr-only"> (opens in a new tab)</span></a> and have read the <a href="/privacy/" target="_blank" rel="noopener">privacy policy<span class="sr-only"> (opens in a new tab)</span></a>.</label></div><span class="field-error" id="agreement-error"></span></div>
          <button class="button-primary" type="submit"><span>Preview introduction</span><Arrow /></button>
        </fieldset>
        <p class="preview-note" id="preview-note">Design preview. Your details aren’t sent or saved.</p>
        <noscript><p class="notice">Enable JavaScript to enter your name and continue. You can read the terms and privacy policy without it.</p><style>#skip-intro { display: none; }</style></noscript>
        <div id="form-status" class="form-status" role="status" tabindex="-1" hidden><strong>That’s your introduction, ready.</strong><p>Nothing has been sent or saved. The interactive portfolio is the next chapter — this preview ends here for now.</p></div>
      </form>
      <button class="skip-intro" id="skip-intro" type="button"><span>Continue with name only <span class="skip-context">No email or agreement needed</span></span><Arrow /></button>
      <div id="skip-status" class="form-status" role="status" tabindex="-1" hidden><strong>You’re ready to continue.</strong><p>Nothing has been sent or saved. The interactive portfolio comes next; you’ve reached the end of this three-page preview.</p></div>
    </section>
  </main>
</Shell>
<script>
  import { validateIntroduction } from '../scripts/validation.mjs';
  const form = document.querySelector<HTMLFormElement>('#introduction-form')!;
  const fields = document.querySelector<HTMLFieldSetElement>('#form-fields')!;
  const name = document.querySelector<HTMLInputElement>('#full-name')!;
  const email = document.querySelector<HTMLInputElement>('#email')!;
  const comment = document.querySelector<HTMLTextAreaElement>('#comment')!;
  const agreement = document.querySelector<HTMLInputElement>('#agreement')!;
  const status = document.querySelector<HTMLElement>('#form-status')!;
  const controls = { name, email, comment, agreement };
  const skipStatus = document.querySelector<HTMLElement>('#skip-status')!;
  fields.disabled = false;
  let attempted = false;
  let mode: 'full' | 'name-only' = 'full';
  function showErrors(focus = false) {
    const errors = validateIntroduction({ name: name.value, email: email.value, comment: comment.value, agreement: agreement.checked }, mode);
    for (const [key, input] of Object.entries(controls)) {
      const message = errors[key] || '';
      document.getElementById(`${key}-error`)!.textContent = message;
      input.setAttribute('aria-invalid', String(Boolean(message)));
    }
    if (focus) Object.entries(controls).find(([key]) => errors[key])?.[1].focus();
    return Object.keys(errors).length === 0;
  }
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    attempted = true;
    mode = 'full';
    skipStatus.hidden = true;
    status.hidden = true;
    if (!showErrors(true)) return;
    status.hidden = false;
    status.focus();
  });
  document.getElementById('skip-intro')!.addEventListener('click', () => {
    attempted = true;
    mode = 'name-only';
    status.hidden = true;
    skipStatus.hidden = true;
    if (!showErrors(true)) return;
    skipStatus.hidden = false;
    skipStatus.focus();
  });
  const arrival = document.querySelector<HTMLElement>('.arrival')!;
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  arrival.addEventListener('pointermove', (event) => {
    if (motion.matches || event.pointerType !== 'mouse') return;
    const rect = arrival.getBoundingClientRect();
    arrival.style.setProperty('--orbit-x', `${((event.clientY - rect.top) / rect.height - .5) * -9}deg`);
    arrival.style.setProperty('--orbit-y', `${((event.clientX - rect.left) / rect.width - .5) * 9}deg`);
  });
  arrival.addEventListener('pointerleave', () => {
    arrival.style.setProperty('--orbit-x', '0deg');
    arrival.style.setProperty('--orbit-y', '0deg');
  });
  form.addEventListener('input', () => {
    status.hidden = true;
    skipStatus.hidden = true;
    if (attempted) showErrors();
    document.getElementById('comment-count')!.textContent = `${comment.value.length.toLocaleString('en-US')} / 1,000`;
    comment.style.height = 'auto';
    comment.style.height = `${Math.min(240, comment.scrollHeight)}px`;
  });
</script>
