<div class="orbit-scene" aria-hidden="true">
  <svg class="orbit-art" viewBox="0 0 700 550" fill="none">
    <defs>
      <radialGradient id="sphere-light" cx="30%" cy="25%" r="75%"><stop stop-color="#58636a"/><stop offset=".55" stop-color="#253139"/><stop offset="1" stop-color="#0c151c"/></radialGradient>
      <linearGradient id="orbit-ink" x1="80" y1="80" x2="550" y2="480" gradientUnits="userSpaceOnUse"><stop stop-color="#eff0de" stop-opacity=".15"/><stop offset=".5" stop-color="#eff0de" stop-opacity=".7"/><stop offset="1" stop-color="#eff0de" stop-opacity=".1"/></linearGradient>
      <clipPath id="sphere-clip"><circle cx="350" cy="270" r="124"/></clipPath>
    </defs>
    <g class="orbit-assembly">
      <ellipse id="visitor-path" cx="350" cy="270" rx="309" ry="132" transform="rotate(-28 350 270)" stroke="url(#orbit-ink)"/>
      <ellipse cx="350" cy="270" rx="278" ry="181" transform="rotate(32 350 270)" stroke="url(#orbit-ink)" stroke-dasharray="2 7"/>
      <circle data-orbit-core cx="350" cy="270" r="124" fill="url(#sphere-light)" stroke="#89979a" stroke-opacity=".45"/>
      <g clip-path="url(#sphere-clip)" stroke="#bcc8c5" stroke-opacity=".18">
        <ellipse cx="350" cy="270" rx="42" ry="124" transform="rotate(-28 350 270)"/>
        <ellipse cx="350" cy="270" rx="88" ry="124" transform="rotate(-28 350 270)"/>
        <ellipse cx="350" cy="270" rx="124" ry="35" transform="rotate(-28 350 270)"/>
        <ellipse cx="350" cy="270" rx="124" ry="82" transform="rotate(-28 350 270)"/>
        <path d="M230 335L469 205"/>
      </g>
      <path d="M77 415C160 489 426 388 591 230" stroke="url(#orbit-ink)"/>
      <g class="orbit-static-visitor">
        <circle class="orbit-visitor" cx="591" cy="230" r="9" fill="#e7ecac"/>
        <circle cx="591" cy="230" r="19" stroke="#e7ecac" stroke-opacity=".4"/>
        <path d="M603 219l29-30h40" stroke="#a5b4bb" stroke-opacity=".55"/>
        <text x="614" y="177" fill="#eff0de" font-size="18" font-weight="600" letter-spacing=".04em" font-family="Manrope Variable, sans-serif">YOU ARE HERE</text>
      </g>
      <g class="orbit-traveler" aria-hidden="true">
        <circle class="orbit-visitor" r="9" fill="#e7ecac"/>
        <circle r="19" stroke="#e7ecac" stroke-opacity=".4"/>
        <path d="M12 -11l29-30h40" stroke="#a5b4bb" stroke-opacity=".55"/>
        <text x="53" y="-53" fill="#eff0de" font-size="18" font-weight="600" letter-spacing=".04em" font-family="Manrope Variable, sans-serif">YOU ARE HERE</text>
      </g>
      <circle cx="124" cy="179" r="3" fill="#a5b4bb"/>
      <path d="M115 169l-27-29H30" stroke="#a5b4bb" stroke-opacity=".35"/>
      <path d="M345 270h10m-5-5v10" stroke="#e7ecac"/>
    </g>
    <g stroke="#a5b4bb" stroke-opacity=".4"><path d="M49 80h8m-4-4v8M610 415h8m-4-4v8M235 485h8m-4-4v8"/></g>
  </svg>
</div>
<script>
  document.addEventListener('astro:page-load', () => {
  const traveler = document.querySelector<SVGGElement>('.orbit-traveler');
  if (!traveler) return;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const orbit = { cx: 350, cy: 270, rx: 309, ry: 132, angle: -28 * Math.PI / 180 };
  const speed = 0.00048;
  let frame = 0;
  let visible = true;
  function moveVisitor(now: number) {
    frame = 0;
    if (!reducedMotion.matches && !document.hidden && visible && traveler?.isConnected) {
      const t = now * speed;
      const x = orbit.cx + orbit.rx * Math.cos(t) * Math.cos(orbit.angle) - orbit.ry * Math.sin(t) * Math.sin(orbit.angle);
      const y = orbit.cy + orbit.rx * Math.cos(t) * Math.sin(orbit.angle) + orbit.ry * Math.sin(t) * Math.cos(orbit.angle);
      traveler.setAttribute('transform', `translate(${x} ${y})`);
      frame = requestAnimationFrame(moveVisitor);
    }
  }
  function resume() {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(moveVisitor);
  }
  const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; resume(); });
  observer.observe(traveler.ownerSVGElement!);
  document.addEventListener('visibilitychange', resume);
  reducedMotion.addEventListener('change', resume);
  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(frame);
    observer.disconnect();
    document.removeEventListener('visibilitychange', resume);
    reducedMotion.removeEventListener('change', resume);
  }, { once: true });
  });
</script>
