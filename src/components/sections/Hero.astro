---
/**
 * Hero — identity-first, "upwards" UX.
 *
 * Per the brief: "use the skills you have for UX — what should greet the
 * visitor, what matters more". On a 1080p viewport, this hero must
 * communicate WHO and WHAT without scrolling.
 *
 * Editorial sequence:
 *   1. Small italic kicker
 *   2. Hairline rule
 *   3. Large serif name (display)
 *   4. Italic serif role line
 *   5. Body intro paragraph (3-4 sentences, his actual story)
 *   6. Text-link CTAs (no buttons)
 *   7. Hairline rule
 *
 * No dual-pane layout. The schematic lives in its own section below
 * (Current Work) where it can be the full visual focal point.
 */
import { PROFILE, SITE } from '../../lib/site.ts';
---

<section class="pt-12 pb-16 sm:pt-16 sm:pb-20">
  <p class="kicker">About</p>

  <hr class="rule mt-4" />

  <h1 class="display mt-6 text-5xl sm:text-6xl lg:text-7xl">
    {PROFILE.name}<span class="text-accent">.</span>
  </h1>

  <p class="display-italic mt-4 text-2xl text-fg-muted sm:text-3xl">
    {PROFILE.tagline}
  </p>

  <div class="mt-10 body-text text-fg max-w-2xl">
    <p>
      I design and ship production LLM systems. My current work is an
      <em class="text-accent">AI therapy microservice</em> on Azure AKS —
      Faster-Whisper + Phi-3.5-Mini (INT8) running CPU-only, serving
      300+ daily sessions for an Australian government healthcare client.
    </p>
    <p>
      Alongside that, I work on multi-tenant RAG with pgvector,
      event-driven pipelines on Azure Service Bus and Kafka, and
      regulated fraud-detection systems with automated regulatory
      reporting. Before DeltaShoppe, my final-year project was
      <a class="text-accent underline-offset-4 hover:underline" href="/projects/graphrag-causal">
        GraphRAG-Causal
      </a>, a graph-augmented framework for causal reasoning in news.
    </p>
  </div>

  <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3 font-serif text-base sm:text-lg" role="list">
    <li>
      <a class="italic text-fg-muted hover:text-accent" href="/#work">
        The work <span aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a class="italic text-fg-muted hover:text-accent" href={SITE.cvPath} target="_blank" rel="noopener">
        Résumé <span aria-hidden="true">↗</span>
      </a>
    </li>
    <li>
      <a class="italic text-fg-muted hover:text-accent" href="/#questions">
        Ask a question <span aria-hidden="true">→</span>
      </a>
    </li>
    <li>
      <a class="italic text-fg-muted hover:text-accent" href="/#contact">
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </li>
  </ul>

  <hr class="rule mt-12" />
</section>