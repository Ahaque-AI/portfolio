  <div class="route-stop route-stop-arrival">
    <span class="route-stop-index">01</span><span><strong>Arrival</strong><small>Edit introduction</small></span>
  </div>
  <a class="route-stop route-stop-about" href="/about/" aria-label="Open About Abdul">
    <span class="route-stop-index">02</span><span><strong>About</strong><small>Open About</small></span>
  </a>
  <div class="route-stop route-stop-work" aria-label="Work section, coming next">
    <span class="route-stop-index">03</span><span><strong>Work</strong><small>Coming next</small></span>
  </div>
</div>
<script>
  import { readVisitorName } from '../scripts/visitor-name.mjs';
  document.addEventListener('astro:page-load', () => {
    const map = document.querySelector<HTMLElement>('.star-map');
    if (!map || !readVisitorName()) return;
    void import('../scripts/orbital-map').then(({ mountMap }) => {
      if (map.isConnected) mountMap(map);
    }).catch(() => { /* The authored SVG stays available without WebGL. */ });
  });
</script>
