---
/**
 * Skills — categorized technical skills.
 *
 * Editorial: not boxed cards. Just categorized prose lists,
 * like an "areas of practice" section in a long-form bio.
 */
import { SKILLS } from '../../lib/site.ts';
import Section from '../ui/Section.astro';
---

<Section id="skills" kicker="Areas of practice" title="Skills">
  <div class="body-text space-y-8">
    {SKILLS.map((group) => (
      <div>
        <h3 class="font-serif text-lg italic text-fg-muted">
          {group.category}.
        </h3>
        <p class="mt-1 text-fg">
          {group.items.map((item, i) => (
            <>
              <span>{item}</span>{i < group.items.length - 1 && <span class="text-fg-faint"> · </span>}
            </>
          ))}
        </p>
      </div>
    ))}
  </div>
</Section>