---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" noindex>
  <section class="flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-fg-subtle">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
      Page not found
    </h1>
    <p class="mt-4 max-w-md text-fg-muted">
      The page you were looking for isn't here. Try the home page or jump to a
      section from the navigation.
    </p>
    <a
      href="/"
      class="mt-8 rounded border border-border bg-surface px-4 py-2 text-sm text-fg hover:border-fg-muted"
    >
      Back home
    </a>
  </section>
</BaseLayout>
